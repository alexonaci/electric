{
  "name": "@electric-sql/redis",
  "description": "Redis integration for ElectricSQL - sync Shapes to Redis data structures",
  "version": "1.0.0",
  "author": "ElectricSQL team and contributors.",
  "bugs": {
    "url": "https://github.com/electric-sql/electric/issues"
  },
  "dependencies": {
    "@electric-sql/client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vitest/coverage-istanbul": "2.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "ioredis": "^5.4.1",
    "iovalkey": "^0.3.0",
    "pg": "^8.11.0",
    "prettier": "^3.3.2",
    "redis": "^5.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.5.2",
    "uuid": "^9.0.0",
    "vitest": "^4.0.15"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://electric-sql.com",
  "keywords": [
    "electric",
    "electric-sql",
    "redis",
    "sync",
    "real-time",
    "cache"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electric-sql/electric.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "stylecheck": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}' --no-error-on-unmatched-pattern",
    "style:fix": "pnpm stylecheck --fix",
    "backend:up": "docker compose up -d",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f"
  }
}
